generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Cached dictionary entries for the reader's word-lookup feature.
// `senses` is a JSON string: Array<{ partOfSpeech, definition, example? }>
model WordDefinition {
  word      String   @id
  phonetic  String?
  senses    String
  source    String // "dictionary" | "ai"
  hits      Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
